# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886  # NO `whatsapp:` prefix — code prepends it
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX  # Voice-capable number — set webhook to POST /webhooks/voice

# Google Calendar
GOOGLE_CALENDAR_ID=your_calendar_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=your_api_key

# ElevenLabs Text-to-Speech (voice agent — PR 3 of voice channel separation)
# Used by VoiceService.play_or_say to generate spoken audio for inbound + outbound voice calls.
# Falls back to Polly Joanna if any of these are missing or the API call fails.
ELEVENLABS_API_KEY=your_eleven_labs_api_key
ELEVENLABS_VOICE_ID=x8syuETaTA9JYwAbE2JM     # Ava — Captivating & Clear (SA-English) by default
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5        # Newer + more natural than multilingual_v2; still supports EN + AF

# Database
DATABASE_URL=postgresql://localhost/dr_leroux_receptionist_development

# WhatsApp Template Content SIDs (from Twilio Console)
WHATSAPP_TPL_CONFIRMATION=HXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WHATSAPP_TPL_REMINDER_24H=HXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WHATSAPP_TPL_REMINDER_1H=HXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WHATSAPP_TPL_CANCELLATION=HXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WHATSAPP_TPL_RESCHEDULE=HXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WHATSAPP_TPL_FLAGGED_ALERT=HXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Reception WhatsApp number (for flagged patient alerts)
RECEPTION_WHATSAPP_NUMBER=+27XXXXXXXXXX

# App
# BASE_URL must be a PUBLIC https URL — it builds the patient intake link sent over
# WhatsApp, so it has to be reachable from the patient's phone (not localhost).
BASE_URL=https://intake.chalitaleroux.co.za

# Public intake hostname (the Cloudflare-tunnelled subdomain). When set, the dashboard
# returns 404 on this host — ONLY /intake is served publicly (defence-in-depth).
INTAKE_PUBLIC_HOST=intake.chalitaleroux.co.za

# Folder where completed intake PDFs are saved (the bind-mounted "1. Patient Files").
INTAKE_FILE_DIR=/patient_files

# Active Record Encryption keys for PHI (patient ID numbers, medical history, intake
# form data). Generate once with `bin/rails db:encryption:init` and paste the three
# values here (and in ../_shared/.env + Railway/Docker env). Required before running
# the PHI encryption migration — without them every `encrypts` attribute raises.
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=
# During the one-off backfill leave this true (default); set to false AFTER
# `bin/rails phi:encrypt` succeeds, to reject any stray plaintext.
AR_ENCRYPTION_SUPPORT_UNENCRYPTED=true

# Email — completed intake packs are emailed to the practice (reception prints + files).
# INTAKE_NOTIFY_EMAIL is the inbox that receives them; SMTP_* drives delivery in
# production (if SMTP_ADDRESS is unset, mail is logged, not sent). APP_HOST is the
# public host used in email links.
INTAKE_NOTIFY_EMAIL=info@drchalitaleroux.co.za
MAILER_FROM_ADDRESS=reception@drchalitaleroux.co.za
APP_HOST=your-public-host.example.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USER_NAME=
SMTP_PASSWORD=

# Dashboard auth (HTTP Basic on every non-webhook route)
# Leave both blank to disable auth (dev/test only). In production, set both
# to a strong shared password until per-user Devise auth lands.
DASHBOARD_USERNAME=reception
DASHBOARD_PASSWORD=replace_me_with_strong_password
