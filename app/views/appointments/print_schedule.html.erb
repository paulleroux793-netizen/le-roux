<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Appointment Details — <%= @date.strftime("%d-%b-%Y") %></title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #1a1a1a; margin: 0; padding: 18px; background: #fff; }
    .page { page-break-after: always; margin-bottom: 28px; }
    .page:last-child { page-break-after: auto; margin-bottom: 0; }
    .title { background: #4a73b5; color: #fff; text-align: center; font-size: 20px; font-weight: bold; letter-spacing: .5px; padding: 11px; border-radius: 4px 4px 0 0; }
    .meta { background: #e9eef6; display: flex; justify-content: space-between; padding: 6px 11px; font-weight: bold; }
    .meta + .meta { border-top: 1px solid #d6deea; }
    .meta .r { text-align: right; }
    table { width: 100%; border-collapse: collapse; }
    thead th { background: #4a73b5; color: #fff; text-align: left; padding: 5px 9px; font-size: 12px; font-weight: bold; }
    thead th.num { text-align: right; }
    tbody td { padding: 5px 9px; border-bottom: 1px solid #dcdcdc; vertical-align: top; }
    tbody tr:nth-child(even) td { background: #f7f9fc; }
    .closed td { color: #999; font-style: italic; }
    .time { white-space: nowrap; width: 58px; }
    .name { font-weight: bold; }
    .tag { font-weight: normal; color: #4a73b5; }
    .reason { color: #444; white-space: pre-line; margin-top: 1px; }
    .num { text-align: right; white-space: nowrap; }
    .cell { white-space: nowrap; }
    .empty { padding: 14px 9px; color: #999; font-style: italic; }
    .foot { margin-top: 8px; font-size: 10px; color: #999; }
    .bar { background: #4a73b5; color: #fff; font-size: 10px; padding: 5px 9px; border-radius: 0 0 4px 4px; margin-top: -1px; }
    @media print { body { padding: 0; } .noprint { display: none !important; } }
    .noprint { text-align: center; margin: 0 0 16px; }
    .btn { background: #4a73b5; color: #fff; border: 0; border-radius: 8px; padding: 9px 18px; font-size: 14px; font-weight: 600; cursor: pointer; }
  </style>
</head>
<body>
  <div class="noprint">
    <button class="btn" onclick="window.print()">Print / Save as PDF</button>
  </div>

  <% @schedules.each do |prov, appts| %>
    <div class="page">
      <div class="title">APPOINTMENT DETAILS</div>
      <div class="meta">
        <div>Date printed: <%= @printed_on.strftime("%d-%b-%Y") %></div>
        <div class="r">Page 1 of 1</div>
      </div>
      <div class="meta">
        <div>Resource: <%= prov.name.upcase %></div>
        <div class="r"><%= @date.strftime("%d-%b-%Y") %></div>
      </div>
      <table>
        <thead>
          <tr>
            <th class="time">Start</th>
            <th class="time">End</th>
            <th>Details</th>
            <th>File</th>
            <th class="num">Due</th>
            <th class="cell">Cellular</th>
          </tr>
        </thead>
        <tbody>
          <tr class="closed"><td class="time">07:00</td><td class="time"><%= @open_time %></td><td colspan="4">Closed</td></tr>
          <% if appts.none? %>
            <tr><td colspan="6" class="empty">No appointments booked for this day.</td></tr>
          <% end %>
          <% appts.each do |a| %>
            <% patient = a.patient %>
            <% is_new = patient.appointments.where.not(id: a.id).none? %>
            <% tag = is_new ? "New patient" : patient.account_code.presence %>
            <tr>
              <td class="time"><%= a.start_time.strftime("%H:%M") %></td>
              <td class="time"><%= a.end_time.strftime("%H:%M") %></td>
              <td>
                <span class="name"><%= patient.full_name %></span><% if tag %> <span class="tag">[<%= tag %>]</span><% end %>
                <% if a.reason.present? %><div class="reason"><%= a.reason %></div><% end %>
              </td>
              <td></td>
              <td class="num">0.00</td>
              <td class="cell"><%= patient.phone %></td>
            </tr>
          <% end %>
          <tr class="closed"><td><%= @close_time %></td><td>18:00</td><td colspan="4">Closed</td></tr>
        </tbody>
      </table>
      <div class="bar">Dr Chalita le Roux Inc · printed from Ivory <%= @printed_on.strftime("%d-%b-%Y") %></div>
    </div>
  <% end %>

  <script>
    window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 350); });
  </script>
</body>
</html>
