<!DOCTYPE html>
<html>
  <head>
    <title data-inertia>Dr Chalita le Roux — AI Receptionist</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%# Open Graph — the rich preview card WhatsApp shows when the intake link is
        shared. WhatsApp's crawler reads these server-rendered tags (no JS). The
        intake form is the only public, shareable URL, so these describe it. %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Dr Chalita le Roux">
    <meta property="og:title" content="Secure Patient Form — Dr Chalita le Roux | Roodepoort">
    <meta property="og:description" content="Complete your details, medical history and consent securely in about 5 minutes on your phone. Paperless, private and POPIA-aligned — so you spend less time at reception.">
    <meta property="og:image" content="<%= request.base_url %>/brand/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= vite_react_refresh_tag %>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "inertia.jsx", media: "all", "data-turbo-track": "reload" %>
    <%= vite_javascript_tag "inertia.jsx" %>
    <%= inertia_ssr_head %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
