# Copy to .env and fill in. .env is gitignored.
SCRIBE_API_URL=http://localhost:3000
SCRIBE_API_TOKEN=replace-me-must-match-rails-env
SCRIBE_DEVICE_NAME=Surgery 1
SCRIBE_WHISPER_MODEL=small.en
SCRIBE_CHUNK_SECONDS=15
SCRIBE_HEARTBEAT_SECONDS=60
# Leave SCRIBE_AUDIO_INPUT_INDEX blank to use the system default mic.
# Run `python -c "import sounddevice; print(sounddevice.query_devices())"` to list mic indices.
SCRIBE_AUDIO_INPUT_INDEX=
